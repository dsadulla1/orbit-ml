# orbit configuration. Copy to .env and edit:  cp .env.example .env
# orbit reads .env from the current directory. Docker Compose reads it when run from the
# repository root with: docker compose --env-file .env -f docker/compose.yaml ...
# Keep comments on their own lines.

# --- LLM: OpenAI (default) ---------------------------------------------------------------
OPENAI_API_KEY=
ORBIT_LLM_MODEL=gpt-5-mini

# --- LLM: local vLLM (docker compose --profile local-llm) -----------------------------------
# ORBIT_LLM_BASE_URL=http://localhost:8000/v1
# ORBIT_LLM_API_KEY=EMPTY
# ORBIT_LLM_MODEL=orbit-coder
# ORBIT_LLM_TEMPERATURE=0.2

# --- LLM: any other OpenAI-compatible server ------------------------------------------------
# Ollama:    ORBIT_LLM_BASE_URL=http://localhost:11434/v1  ORBIT_LLM_API_KEY=ollama
# LM Studio: ORBIT_LLM_BASE_URL=http://localhost:1234/v1

# Optional request settings (only sent when set). Prompt + completion must fit the
# server's context window (VLLM_MAX_MODEL_LEN for vLLM).
# ORBIT_LLM_MAX_TOKENS=8192
# ORBIT_LLM_TIMEOUT=300

# --- Sandbox -------------------------------------------------------------------------------
ORBIT_SANDBOX_IMAGE=orbit-sandbox:latest
ORBIT_SANDBOX_CPUS=4
ORBIT_SANDBOX_MEMORY=8g
ORBIT_SANDBOX_TIMEOUT=600
# gVisor, after installing runsc and registering it with Docker:
# ORBIT_SANDBOX_RUNTIME=runsc

# --- Tracking ------------------------------------------------------------------------------
# MLflow is the default tracker. Point it at the compose service:
MLFLOW_TRACKING_URI=http://localhost:5000
# Setting a W&B key makes W&B the default tracker (needs: uv sync --extra wandb).
# WANDB_API_KEY=

# --- Docker Compose services -----------------------------------------------------------------
# MLflow listens on localhost only; 0.0.0.0 exposes it (unauthenticated) to your network.
MLFLOW_BIND=127.0.0.1
MLFLOW_PORT=5000
# Comma-separated Host-header allowlist; empty keeps MLflow's default (localhost + private IPs).
# MLFLOW_ALLOWED_HOSTS=

VLLM_IMAGE_TAG=v0.29.0
VLLM_MODEL=QuantTrio/Qwen3-Coder-30B-A3B-Instruct-AWQ
VLLM_SERVED_NAME=orbit-coder
# Tensor parallel size; must match the number of device_ids in docker/compose.yaml.
VLLM_TP=2
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_UTIL=0.90
VLLM_PORT=8000
# Needed only for gated models.
HF_TOKEN=
# Host path for the Hugging Face cache; unset uses the hf-cache Docker volume.
# HF_CACHE=/home/you/.cache/huggingface
